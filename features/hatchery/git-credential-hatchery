#!/bin/sh
# git credential helper for GitHub. Needs credential.useHttpPath=true so git
# sends path=<org>/<repo>.git; the repo is passed to the creds socket (?repo=)
# so multi-org drones get a token for the right org.
TOKEN_BIN="${HATCHERY_TOKEN_BIN:-/usr/local/bin/hatchery-token}"
case "$1" in
  get)
    REPO=""
    while IFS= read -r line && [ -n "$line" ]; do
      case "$line" in
        path=*)
          REPO="${line#path=}"; REPO="${REPO#/}"
          # keep only org/repo (drop any further segments), strip .git
          ORG="${REPO%%/*}"; REST="${REPO#*/}"; REST="${REST%%/*}"
          if [ "$ORG" != "$REPO" ] && [ -n "$REST" ]; then REPO="$ORG/${REST%.git}"; else REPO="${REPO%.git}"; fi
          ;;
      esac
    done
    if [ -n "$REPO" ]; then
      T=$("$TOKEN_BIN" "repo=${REPO}") || exit 1
    else
      T=$("$TOKEN_BIN") || exit 1
    fi
    echo "protocol=https"
    echo "host=github.com"
    echo "username=x-access-token"
    echo "password=$T"
    ;;
esac
